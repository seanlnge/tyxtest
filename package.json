{
  "name": "tyxtest",
  "version": "1.0.0",
  "description": "Product-surface tests for TypeScript. Claims are checked against source, not a running app.",
  "type": "module",
  "bin": {
    "tyxtest": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "tyxtest": "node dist/cli.js"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.1.0",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2"
  }
}
