{
  "markdown": {
    "testDiscovery": {
      "mode": "headings",
      "headingLevel": 2,
      "prefix": null
    }
  },
  "indexModel": {
    "provider": "openai",
    "model": "gpt-6-luna",
    "apiKeyEnv": "OPENAI_KEY"
  },
  "runnerModel": {
    "provider": "typesafe",
    "model": "jev",
    "kind": "decision",
    "apiKeyEnv": "TYPESAFE_API_KEY"
  },
  "escalate": true,
  "escalateModel": null,
  "fallback": true,
  "thresholds": {
    "pass": 0.8,
    "fail": 0.2
  },
  "ignoreUnchanged": false,
  "baseRef": "origin/main",
  "nonInteractive": "fail",
  "reruns": 2,
  "verdictRule": "worst",
  "unsureBlocks": false,
  "triage": false,
  "relocateCheck": true,
  "maxQuestions": 5,
  "chunkMaxTokens": 4000,
  "concurrency": 8,
  "guards": {
    "literalKeyCheck": true,
    "gitignoreEnv": true
  }
}
